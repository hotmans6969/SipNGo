# SipNGo environment variables.
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Required ---
# Signing key for session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to boot without this.
JWT_SECRET=

# --- Admin bootstrap ---
# Used once, on first run, to seed the initial admin account.
# If unset, no admin is created and you must promote a user manually.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Stripe (optional) ---
# Leave both empty in development to simulate payments.
# In production, an empty STRIPE_SECRET_KEY is an error unless
# ALLOW_SIMULATED_PAYMENTS below is set to true.
STRIPE_SECRET_KEY=sk_test_REDACTED_ROLLED
STRIPE_WEBHOOK_SECRET=whsec_REDACTED_ROLLED

# Wallet types offered by the E-wallet option at checkout, comma separated.
# Must be enabled on the Stripe account or the session is rejected.
# Defaults to grabpay, the wallet Stripe supports for ringgit.
STRIPE_EWALLET_METHODS=grabpay

# A hosted Stripe Payment Link used for the card and e-wallet options instead
# of building a Checkout Session. Needs no secret key, so it works on a
# deployment that has none yet. Ignored once STRIPE_SECRET_KEY is set, because
# a session charges the order's real total and a link cannot.
#
# WARNING: a payment link charges the FIXED amount configured on it in the
# Stripe dashboard. There is no URL parameter for the amount, so every order
# is charged the same regardless of its total. Test-mode scaffolding only —
# unset this to go back to real Checkout Sessions that charge the right amount.
#
# The order is only marked paid when Stripe's checkout.session.completed
# webhook arrives, which needs STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET set.
# Without them, staff settle the order by hand with Take Payment.
#
# Set the link's own after-payment redirect, in the Stripe dashboard, to
#   <NEXT_PUBLIC_APP_URL>/pay/return
# That is what brings the customer back to their pickup QR code. A link has
# nowhere to carry the order id, so the app leaves itself a note in the
# browser before handing over and reads it back there.
STRIPE_PAYMENT_LINK_URL=

# Set to "true" to run a PRODUCTION deployment in demo mode: orders are placed
# and marked paid without any money changing hands. Only for a showcase or test
# deployment — never set this on a deployment taking real orders.
ALLOW_SIMULATED_PAYMENTS=

# --- Database ---
# Leave both empty for local development: the app falls back to a local
# SQLite file, so you need no account and no network.
#
# In production point these at Turso:
#   DATABASE_URL=libsql://<your-db>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token from `turso db tokens create`>
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Local file used when DATABASE_URL is unset.
DATABASE_PATH=sipngo.db

# --- Push notifications (optional) ---
# Without these the app works normally; customers just get the in-app banner
# instead of a notification that arrives with the app closed.
# Generate a pair with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys(),null,2))"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services can reach you at, as a mailto: URL.
VAPID_SUBJECT=mailto:you@example.com

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Surcharge added to an iced drink, in sen. Defaults to 100 (RM 1.00).
ICED_SURCHARGE_CENTS=100

# --- Native / tunnel dev (optional) ---
# Host the Capacitor Android wrapper points at, e.g. 192.168.1.20:3000
CAPACITOR_SERVER_URL=
# Comma-separated extra dev origins allowed by Next, e.g. *.ngrok-free.app,*.loca.lt
EXTRA_DEV_ORIGINS=
