# SipNGo environment variables.
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Required ---
# Signing key for session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to boot without this.
JWT_SECRET=

# --- Admin bootstrap ---
# Used once, on first run, to seed the initial admin account.
# If unset, no admin is created and you must promote a user manually.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Stripe (optional) ---
# Leave both empty in development to simulate payments.
# In production, an empty STRIPE_SECRET_KEY is a hard startup error.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Surcharge added to an iced drink, in sen. Defaults to 100 (RM 1.00).
ICED_SURCHARGE_CENTS=100

# --- Native / tunnel dev (optional) ---
# Host the Capacitor Android wrapper points at, e.g. 192.168.1.20:3000
CAPACITOR_SERVER_URL=
# Comma-separated extra dev origins allowed by Next, e.g. *.ngrok-free.app,*.loca.lt
EXTRA_DEV_ORIGINS=
