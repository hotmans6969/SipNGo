# Committed, non-secret production defaults. Declaring them here makes them a
# visible property of the repository rather than an invisible setting in a
# hosting dashboard.
#
# Secrets never belong here. This file is public — the Stripe keys live in
# Vercel's environment variables, and /api/health reports whether they arrived.
#
# This line no longer does anything: the deployment now has a Stripe key, and a
# configured key always wins. It matters only if that key ever goes missing,
# and then it decides between two failures — simulate payments and give drinks
# away silently, or refuse to start and say so. Silence was right while this
# was a demo with no Stripe account. Now that it takes payments, consider
# deleting the line so a lost key fails loudly instead.
ALLOW_SIMULATED_PAYMENTS=true

# Where this deployment lives. Without it the app falls back to localhost, and
# a Checkout Session would send customers to a success page on their own
# machine rather than back here.
NEXT_PUBLIC_APP_URL=https://sip-n-go.vercel.app
