# Committed, non-secret production defaults for the public demo deployment.
#
# This deployment exists to show the ordering flow, and has no Stripe account
# behind it. Declaring that here makes it a visible property of the repository
# rather than an invisible setting in a hosting dashboard.
#
# Adding a real STRIPE_SECRET_KEY overrides this automatically: a configured
# key always wins, so a shop that starts taking real payments cannot keep
# giving drinks away because of this file.
#
# Secrets never belong here. This file is public.
ALLOW_SIMULATED_PAYMENTS=true

# Where this deployment lives. Without it the app falls back to localhost, and
# a Checkout Session would send customers to a success page on their own
# machine rather than back here.
NEXT_PUBLIC_APP_URL=https://sip-n-go.vercel.app

# Test-mode Stripe payment link used for the card and e-wallet options. Not a
# secret: a payment link is meant to be handed to customers, and a test-mode
# one cannot move real money.
#
# For the customer to come back to their pickup QR code, this link's own
# "After the payment" setting in the Stripe dashboard has to redirect to
#   https://sip-n-go.vercel.app/pay/return
#
# It charges the FIXED amount configured on the link, not the order total, so
# this is scaffolding for demonstrating the flow. Setting STRIPE_SECRET_KEY
# overrides it with a real Checkout Session that charges the right amount.
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/test_9B6eVf5XK7isg5o08uf3a00
