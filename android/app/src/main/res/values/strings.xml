<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Points Android at the site's assetlinks.json. If the fingerprint there
         does not match the certificate that signed this APK, Chrome shows its
         address bar instead of running full-screen. -->
    <string name="asset_statements" translatable="false">
        [{
          \"relation\": [\"delegate_permission/common.handle_all_urls\"],
          \"target\": {
            \"namespace\": \"web\",
            \"site\": \"https://sip-n-go.vercel.app\"
          }
        }]
    </string>
</resources>
